# Copiar como .env (no se versiona) y reemplazar los valores.

# MySQL local, para ejecutar la aplicación fuera de Docker.
ip=127.0.0.1
port=3306
user=root
password=cambiar

# Docker (docker compose)
SIGECAP_MYSQL_ROOT_PASSWORD=cambiar-por-una-clave-larga
SIGECAP_DB_PASSWORD=cambiar-por-otra-clave-larga
# SIGECAP_DOCKER_DB_PORT=3307
